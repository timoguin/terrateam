#!/usr/bin/env bash
set -euf -o pipefail

if [ "${TERRATEAM_ENVIRONMENT}" == "production" ]; then
  # The "What's Changed" entries of the release notes, one per line, turned into Slack
  # bullets. scripts/create_release has already expanded the monorepo export entries into the
  # changes they publish, each tailed with "in <pr url>"; an entry for a PR opened directly on
  # this repo reads "* <title> by <author> in <pr url>". Both tails are peeled off here, each
  # anchored on the trailing URL so a title of its own ("Sort by name", "Fix a crash in
  # production") survives intact.
  RELEASE_NOTES=$(gh release view --repo "${GITHUB_REPOSITORY}" --json body | jq -r '.body' \
    | awk '/## What'\''s Changed/,/^$/' \
    | sed -E -e '/^## What'\''s Changed/d' -e '/^[[:space:]]*$/d' \
             -e 's| by [^[:space:]]+ in https?://[^[:space:]]+$||' \
             -e 's| in https?://[^[:space:]]+$||' \
             -e 's/^\*[[:space:]]*/\• /')

  PAYLOAD=$(jq -n --arg pretext "A new release has been created for ${GITHUB_REPOSITORY}!" \
                --arg title "Release ${VERSION_TAG}" \
                --arg title_link "https://github.com/${GITHUB_REPOSITORY}/releases/tag/${VERSION_TAG}" \
                --arg text "${RELEASE_NOTES}" \
                --arg footer "GitHub Actions" \
                --arg footer_icon "https://platform.slack-edge.com/img/default_application_icon.png" \
                --arg color "#36a64f" \
                --arg fallback "New release created: ${VERSION_TAG}" \
                --argjson ts "$(date +%s)" \
                '{
                  attachments: [
                    {
                      fallback: $fallback,
                      color: $color,
                      pretext: $pretext,
                      title: $title,
                      title_link: $title_link,
                      text: $text,
                      footer: $footer,
                      footer_icon: $footer_icon,
                      ts: $ts
                    }
                  ]
                }')

  curl -X POST -H 'Content-type: application/json' --data "${PAYLOAD}" "${SLACK_WEBHOOK_URL}"
fi
