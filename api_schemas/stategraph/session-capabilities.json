          "$ref": "#/definitions/access-token-refresh"
        },
        "admin": {
          "$ref": "#/definitions/admin"
        },
        "commit": {
          "$ref": "#/definitions/commit"
        },
        "preview": {
          "$ref": "#/definitions/preview"
        },
        "sudo": {
          "$ref": "#/definitions/sudo"
        },
        "users-manage": {
          "$ref": "#/definitions/users-manage"
        }
      },
      "type": "object"
    },
    "commit": {
      "additionalProperties": false,
      "properties": {
        "states": {
          "$ref": "#/definitions/states"
        },
        "subgraph": {
          "$ref": "#/definitions/states"
